# Local development only — copy to .env (never commit .env)

# Cloud SQL (via Auth Proxy or local Postgres)
DATABASE_URL=postgresql://lanonna:changeme@127.0.0.1:5432/lanonna

# Firebase Admin (path to service account JSON locally; Secret Manager in prod)
GOOGLE_APPLICATION_CREDENTIALS=/path/to/firebase-admin.json

# GCS
GCS_BUCKET_DISPLAY=lanonna-display-dev
GCS_BUCKET_THUMBNAILS=lanonna-thumbnails-dev

# Pub/Sub
PUBSUB_TOPIC_UPLOAD=photo-upload-finalized

# Optional local overrides
PORT=8080
LOG_LEVEL=info
