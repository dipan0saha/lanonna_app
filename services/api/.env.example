ENVIRONMENT=dev
GCP_PROJECT_ID=lanonna-dev
# Optional: comma-separated Firebase ID token audiences (default: GCP_PROJECT_ID only)
# FIREBASE_AUDIENCES=lanonna-dev
GCS_SIGNING_SERVICE_ACCOUNT=lanonna-api@lanonna-dev.iam.gserviceaccount.com
DISPLAY_BUCKET=lanonna-dev-display

# Local DB via Cloud SQL Auth Proxy (5432 or 5433 — match scripts/Maestro):
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_USER=lanonna_app
# DB_NAME=lanonna
# DB_PASSWORD=  # gcloud secrets versions access latest --secret=db-lanonna-app-password

# Optional local dev flags (see lanonna_api/config.py):
# NOTIFY_PUBLISH_DISABLED=true
# INVITE_EMAIL_PUBLISH_DISABLED=true
# APP_CHECK_ENFORCE=false
# PUBSUB_TOPIC_UPLOAD=photo-upload-finalized
# PUBSUB_TOPIC_COMMANDS=lanonna-async-commands
# ADMIN_API_KEY=  # local admin routes only
