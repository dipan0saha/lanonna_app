# Local development only — copy to .env (never commit .env)

ENVIRONMENT=dev
GCP_PROJECT_ID=lanonna-dev
DISPLAY_BUCKET=lanonna-dev-display
THUMBNAILS_BUCKET=lanonna-dev-thumbnails

# Cloud SQL via Auth Proxy (same vars as API):
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_USER=lanonna_app
# DB_NAME=lanonna
# DB_PASSWORD=

MAILJET_API_KEY=
MAILJET_API_SECRET=
# Required. Dev uses the Mailjet-validated sender in infra/env/dev.worker.env.
# Do not use hello@lanonna.app — Mailjet accepts it and does not deliver.
MAILJET_FROM_EMAIL=lanonnaapp@gmail.com
INVITE_DEEP_LINK_BASE=lanonna://app

PORT=8081
