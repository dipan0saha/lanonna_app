# Copy to local.env (gitignored). Passwords are never committed.
#
# Optional: stable Firebase App Check debug UUID for Android debug APKs (register once in
# Firebase Console / `register-app-check-debug.sh`). Rebuild after changing.
# APP_CHECK_DEBUG_TOKEN=00000000-0000-0000-0000-000000000000

SMOKE_TEST_EMAIL=lanonna.dev.smoke@test.com
SMOKE_TEST_PASSWORD=

# Follower / dual-role Maestro flows (same Firebase dev project)
FOLLOWER_TEST_EMAIL=lanonna.dev.follower@test.com
FOLLOWER_TEST_PASSWORD=

# Optional: dedicated user for onboarding_owner_fresh flow (Firebase account must exist)
ONBOARDING_TEST_EMAIL=lanonna.dev.onboard@test.com
ONBOARDING_TEST_PASSWORD=

# Optional P0 Maestro flows (run-maestro-p0.sh / premerge_check.sh --e2e)
# Sign-up + account delete: a test-inbox address with {ts}; each run creates a new
# account at that address (random password, never printed), marks it verified, then
# deletes it through the app.
# P0_DISPOSABLE_EMAIL_TEMPLATE=you+p0-{ts}@your-test-inbox.example
# Biometric enable + sign-in (needs an enrolled emulator fingerprint):
# P0_RUN_BIOMETRIC=1
# Reuse the installed debug APK instead of rebuilding:
# P0_SKIP_BUILD=1
# Screen-lock PIN of the test emulator; unlocks a cold-booted emulator before P0 runs.
# MAESTRO_DEVICE_PIN=
