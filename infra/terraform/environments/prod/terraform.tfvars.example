# Prerequisites: GCP project quota for lanonna-prod, billing linked, state bucket created.
# cp terraform.tfvars.example terraform.tfvars  (terraform.tfvars is gitignored)

project_id        = "lanonna-prod"
region            = "us-central1"
bucket_display    = "lanonna-prod-display"
bucket_thumbnails = "lanonna-prod-thumbnails"

# Dedicated core (Cloud SQL SLA); zonal launch sizing ~$35–60/mo with warm API + small SQL.
sql_tier                = "db-custom-1-3840"
sql_disk_gb             = 10
sql_disk_autoresize_limit = 20
sql_availability        = "ZONAL"

# Set in terraform.tfvars (not committed):
# monitoring_notification_emails = ["ops@example.com"]
# After API deploy: monitoring_api_host = "api-xxxxxxxx-uc.a.run.app"

# After worker is deployed to prod, in module "platform" (prod/main.tf) set:
#   enable_worker_push_subscription = true
#   worker_push_subscription_name   = "photo-upload-finalized-push-prod"
#   worker_push_commands_subscription_name = "lanonna-async-commands-push-prod"
# Leave worker_push_endpoint empty to read from Cloud Run service `worker`.
