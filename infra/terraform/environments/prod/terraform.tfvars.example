# Create project lanonna-prod, link billing, create gs://lanonna-prod-terraform-state, then:
# cp terraform.tfvars.example terraform.tfvars

project_id        = "lanonna-prod"
region            = "us-central1"
bucket_display    = "lanonna-prod-display"
bucket_thumbnails = "lanonna-prod-thumbnails"
sql_tier          = "db-custom-2-7680"
sql_disk_gb       = 20

# After worker is deployed to prod, in module "platform" (prod/main.tf) set:
#   enable_worker_push_subscription = true
#   worker_push_subscription_name   = "photo-upload-finalized-push-prod"
#   worker_push_commands_subscription_name = "lanonna-async-commands-push-prod"
# Leave worker_push_endpoint empty to read from Cloud Run service `worker`.
