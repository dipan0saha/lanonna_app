# Non-secret worker settings for lanonna-prod (project not created yet).
# Worker Cloud Run min instances stay 0 in deploy.sh (Pub/Sub push tolerates cold start).
# MAILJET_FROM_EMAIL must be a sender validated in the prod Mailjet account.
# Quote values that contain spaces. deploy.sh parses this file; it does not execute it.
MAILJET_FROM_EMAIL=__SET_PROD_MAILJET_FROM_EMAIL__
MAILJET_FROM_NAME="La Nonna"
