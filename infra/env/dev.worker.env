# Non-secret worker settings for lanonna-dev.
# MAILJET_FROM_EMAIL lives in dev.worker.local.env (see dev.worker.local.env.example).
# hello@lanonna.app is not validated: Mailjet accepts the send (HTTP 200) and drops it.
# Quote values that contain spaces. deploy.sh parses these files; it does not execute them.
MAILJET_FROM_NAME="La Nonna"
