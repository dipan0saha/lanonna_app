# Non-secret worker settings for lanonna-dev.
# MAILJET_FROM_EMAIL must be a sender validated in the dev Mailjet account.
# hello@lanonna.app is not validated: Mailjet accepts the send (HTTP 200) and drops it.
# Quote values that contain spaces. deploy.sh parses this file; it does not execute it.
MAILJET_FROM_EMAIL=lanonnaapp@gmail.com
MAILJET_FROM_NAME="La Nonna"
