# Non-secret API Cloud Run settings for lanonna-prod (project not created yet).
# services/api/scripts/deploy.sh parses this file; it does not execute it.
# A variable already set in the shell wins over the value here.

# Match dev warm-instance policy until prod traffic patterns are known.
API_MIN_INSTANCES=1
API_MAX_INSTANCES=10

# Enforce before public beta (H-05). Override in the shell only for a one-off test deploy.
APP_CHECK_ENFORCE=true
