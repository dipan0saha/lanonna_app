# Non-secret API Cloud Run settings for lanonna-dev.
# services/api/scripts/deploy.sh parses this file; it does not execute it.
# A variable already set in the shell wins over the value here.

# Keep one warm instance so the first request after an idle period skips the
# ~9-10 s cold start (container start + Cloud SQL connector). Idle cost is about
# $10/month at 1 vCPU / 512 MiB (CPU throttled when idle). Environments without
# this file keep the deploy.sh default of 0 (scale to zero).
API_MIN_INSTANCES=1
# 10 instances x DB_POOL_MAX_SIZE 5 stays inside the Cloud SQL connection budget
# (docs/engineering/development.md). Raise only together with the pool size.
API_MAX_INSTANCES=10
