# Copy to project.env (local only; do not commit project.env with secrets)
# Used by infra/gcp/bootstrap.sh

GCP_PROJECT_ID=lanonna-dev
GCP_REGION=us-central1
GCP_BILLING_ACCOUNT_ID=018CE3-2C7894-996502

# Buckets (global names)
GCS_BUCKET_DISPLAY=lanonna-dev-display
GCS_BUCKET_THUMBNAILS=lanonna-dev-thumbnails

# Pub/Sub
PUBSUB_TOPIC_UPLOAD=photo-upload-finalized
PUBSUB_SUBSCRIPTION_WORKER=photo-upload-finalized-worker

# Cloud SQL
SQL_INSTANCE=lanonna-db
SQL_DATABASE=lanonna
SQL_APP_USER=lanonna_app

# Artifact Registry
ARTIFACT_REPO=lanonna
ARTIFACT_LOCATION=us-central1

# Service accounts (emails)
SA_AUTOMATION=lanonna-automation@lanonna-dev.iam.gserviceaccount.com
SA_API=lanonna-api@lanonna-dev.iam.gserviceaccount.com
SA_WORKER=lanonna-worker@lanonna-dev.iam.gserviceaccount.com

# Local path for automation key (never commit the JSON file)
AUTOMATION_KEY_PATH="${HOME}/Neo_Workspace/secrets/lanonna/gcp-automation-key.json"
